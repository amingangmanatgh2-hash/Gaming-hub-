// AMIN Keyboard & Clipboard - resources
#include <windows.h>

// Application icon (also used for the tray)
1 ICON "icon.ico"

// Application manifest: common controls v6, asInvoker (no admin), DPI aware
1 24 "app.manifest"

1 VERSIONINFO
 FILEVERSION    1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         0x40004L
 FILETYPE       0x1L
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "AMIN"
            VALUE "FileDescription",  "AMIN Keyboard & Clipboard"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "AminKeyboardClipboard"
            VALUE "LegalCopyright",   "Free to use and modify"
            VALUE "OriginalFilename", "AminKeyboardClipboard.exe"
            VALUE "ProductName",      "AMIN Keyboard & Clipboard"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
