<Window x:Class="AMIN_Keyboard_Clipboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AMIN_Keyboard_Clipboard.Controls"
        xmlns:app="clr-namespace:AMIN_Keyboard_Clipboard"
        Title="AMIN Keyboard &amp; Clipboard" Height="640" Width="620"
        MinHeight="500" MinWidth="440"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Icon="Resources/amin.ico" FontFamily="Segoe UI" FontSize="13"
        Background="{StaticResource PrimaryBackground}"
        Loaded="MainWindow_Loaded"
        Deactivated="MainWindow_Deactivated"
        Closing="MainWindow_Closing">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Background="Transparent">
            <TabItem Header="🕋 Virtual Keyboard">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="2,0,0,8"
                                   Text="Click a key to type into the focused application. Tip: use the floating keyboard (always on top) for convenient typing — switch to the app you want to type into first, then press the keys."/>
                        <local:KeyboardPanel x:Name="kbMain"/>
                    </StackPanel>
                </Border>
            </TabItem>
            <TabItem Header="📋 Clipboard Manager">
                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBox x:Name="txtSearch" Grid.Row="0" Height="30" Margin="0,0,0,8"
                                 TextChanged="TxtSearch_TextChanged"
                                 VerticalContentAlignment="Center"
                                 app:Watermark.Watermark="Search history..."
                                 Style="{StaticResource ModernTextBox}"/>

                        <ListBox x:Name="lstHistory" Grid.Row="1" Margin="0,0,0,8"
                                 SelectionChanged="LstHistory_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarAutoHide="True"/>

                        <TextBlock x:Name="txtStatus" Grid.Row="2" Margin="0,0,0,8"
                                   HorizontalAlignment="Right" Foreground="{StaticResource TextMuted}"/>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="btnCopy" Content="↑ Copy selected" Click="BtnCopy_Click" Style="{StaticResource RoundedButton}"/>
                            <Button Content="❌ Delete" Click="BtnDelete_Click" Style="{StaticResource RoundedButton}" Margin="8,0,0,0"/>
                            <Button Content="🗑️ Clear all" Click="BtnClear_Click" Style="{StaticResource RoundedButton}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>
            <TabItem Header="⚙️ Settings">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Startup" FontWeight="Bold" Margin="4,8,4,4"/>
                        <CheckBox x:Name="chkStartup" Content="Start AMIN with Windows" Margin="8,0,0,0"
                                  Checked="ChkStartup_Changed" Unchecked="ChkStartup_Changed"/>

                        <TextBlock Text="Global Hotkeys" FontWeight="Bold" Margin="4,16,4,4"/>
                        <TextBlock TextWrapping="Wrap" Margin="8,0,0,0">
                            <Run Text="Ctrl+Alt+K"/><Run Text=" — show / hide floating keyboard"/><LineBreak/>
                            <Run Text="Ctrl+Alt+V"/><Run Text=" — show / hide clipboard popup"/>
                        </TextBlock>

                        <TextBlock Text="Privacy" FontWeight="Bold" Margin="4,16,4,4"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" Margin="8,0,0,0"
                                   Text="All clipboard history is stored locally in %APPDATA%\AMIN_Keyboard_Clipboard\history.json. Nothing is uploaded — no telemetry, no network access."/>

                        <TextBlock Text="Version" FontWeight="Bold" Margin="4,16,4,4"/>
                        <TextBlock x:Name="txtVersion" Margin="8,0,0,0"/>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Bottom controls -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btnKeyboard" Content="🗝️ Show Floating Keyboard" Click="BtnKeyboard_Click" Style="{StaticResource RoundedButton}" Width="195" Margin="0,0,8,0"/>
            <Button x:Name="btnClipboard" Content="📋 Clipboard Popup" Click="BtnClipboard_Click" Style="{StaticResource RoundedButton}" Width="150" Margin="0,0,8,0"/>
            <Button x:Name="btnStartup" Content="▶ Start with Windows" Click="BtnStartup_Click" Style="{StaticResource RoundedButton}" Width="160"/>
            <Button x:Name="btnExit" Content="✕ Exit" Click="BtnExit_Click" Style="{StaticResource RoundedButton}" Width="70" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
