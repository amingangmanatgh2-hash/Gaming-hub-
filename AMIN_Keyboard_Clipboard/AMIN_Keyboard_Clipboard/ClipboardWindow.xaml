<Window x:Class="AMIN_Keyboard_Clipboard.ClipboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AMIN Clipboard" Width="380"
        WindowStyle="None" Topmost="True" ShowInTaskbar="False" Focusable="False"
        ResizeMode="NoResize"
        Background="{StaticResource PrimaryBackground}"
        FontFamily="Segoe UI" FontSize="13">
    <Border x:Name="card" Style="{StaticResource CardStyle}" Margin="8"
            MouseLeftButtonDown="Card_MouseLeftButtonDown">
        <StackPanel>
            <Grid Margin="0,0,0,8">
                <TextBlock Text="📋 Recent clipboard — click an item to copy" VerticalAlignment="Center"/>
                <Button Content="✕" Click="BtnClose_Click" Style="{StaticResource RoundedButton}" Width="30" Height="26" Padding="4,0"/>
            </Grid>
            <ListBox x:Name="lstItems" Height="220"
                     MouseDoubleClick="LstItems_MouseDoubleClick"
                     ScrollViewer.HorizontalScrollBarAutoHide="True"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="↑ Copy" Click="BtnCopy_Click" Style="{StaticResource RoundedButton}" Margin="0,0,8,0"/>
                <Button Content="✕ Close" Click="BtnClose_Click" Style="{StaticResource RoundedButton}"/>
            </StackPanel>
            <TextBlock x:Name="txtHint" Text="Click any item once to copy it."
                       Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,6,0,0"/>
        </StackPanel>
    </Border>
</Window>
