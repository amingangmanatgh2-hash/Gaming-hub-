<Window x:Class="GamingHubOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gaming Hub Optimizer — بهینه‌ساز FPS، کیفیت و دیسپلی" Height="680" Width="1020"
        Background="#0B0E1A" WindowStartupLocation="CenterScreen">
    <Grid FlowDirection="RightToLeft" Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="110"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="🎮 Gaming Hub Optimizer" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="  v1.0.0" Foreground="#94A3B8" VerticalAlignment="Bottom" FontSize="12"/>
        </StackPanel>
        <TextBlock Grid.Row="1" Text="بهینه‌ساز ویندوز برای بازی — بیشترین FPS، بهترین کیفیت تصویر و تنظیم دیسپلی. همه‌ی تغییرات بکاپ گرفته می‌شود و قابل برگشت است."
                   Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,4,0,10"/>

        <TabControl Grid.Row="2" Background="#151A2E" BorderThickness="0">
            <TabItem Header="📊 داشبورد">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock x:Name="TxtSystem" FontSize="14" TextWrapping="Wrap" LineHeight="22"/>
                        <TextBlock x:Name="TxtScore" FontSize="20" FontWeight="Bold" Margin="0,10,0,0"/>
                        <TextBlock x:Name="TxtVerdict" FontSize="14" Foreground="#06B6D4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="🔄 اسکن دوباره" Click="BtnScan_Click"/>
                            <Button Content="🧹 پاک‌سازی کش و Temp" x:Name="BtnClean" Click="BtnClean_Click" Background="#0EA5E9"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtClean" Foreground="#94A3B8" Margin="4,6"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="🚀 پروفایل‌ها">
                <StackPanel Margin="12">
                    <TextBlock Text="یک پروفایل انتخاب کن — تنظیمات پیشنهادی خودش تیک می‌خورد، بعد «اعمال» را بزن:" FontSize="14" Margin="0,0,0,8"/>
                    <WrapPanel>
                        <Button Content="🏆 Max FPS (رقابتی)" Click="BtnProfileFps_Click" Background="#DC2626"/>
                        <Button Content="⚖ متعادل (پیشنهادی)" Click="BtnProfileBalanced_Click"/>
                        <Button Content="💎 Ultra Quality + Display" Click="BtnProfileQuality_Click" Background="#059669"/>
                    </WrapPanel>
                    <GroupBox Header="🚀 FPS" Foreground="White" Margin="0,8"><StackPanel x:Name="PanelFps"/></GroupBox>
                    <GroupBox Header="💎 کیفیت (Quality)" Foreground="White"><StackPanel x:Name="PanelQuality"/></GroupBox>
                    <GroupBox Header="🖥 دیسپلی (Display)" Foreground="White"><StackPanel x:Name="PanelDisplay"/></GroupBox>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="✅ اعمال تنظیمات انتخاب‌شده" Click="BtnApply_Click" Background="#059669" FontWeight="Bold"/>
                        <Button Content="⏹ غیرفعال‌کردن همه (پیش‌فرض ویندوز)" Click="BtnDisableAll_Click" Background="#DC2626" FontWeight="Bold"/>
                        <Button Content="☐ برداشتن همه تیک‌ها" Click="BtnUncheckAll_Click" Background="#475569"/>
                        <Button Content="↩ ری‌استور بکاپ قبلی" Click="BtnRestore_Click" Background="#475569"/>
                        <Button Content="🛡 ساخت Restore Point" Click="BtnRestorePoint_Click" Background="#475569"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="🖥 دیسپلی">
                <StackPanel Margin="12">
                    <TextBlock x:Name="TxtDisplay" FontSize="14" TextWrapping="Wrap" LineHeight="22"/>
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="⚙ بازکردن تنظیمات دیسپلی ویندوز" Click="BtnOpenDisplay_Click"/>
                        <Button Content="🎛 بازکردن تنظیمات گرافیک پیشرفته" Click="BtnOpenGraphics_Click" Background="#0EA5E9"/>
                    </WrapPanel>
                    <TextBlock TextWrapping="Wrap" Foreground="#94A3B8" Margin="0,10,0,0"
                        Text="چک‌لیست تصویر بهتر: ۱) بالاترین Refresh Rate را انتخاب کن ۲) رزولوشن Native مانیتور ۳) داخل بازی: V-Sync خاموش، FPS Cap = نرخ هرتز مانیتور ۴) G-Sync/FreeSync روشن ۵) حالت Game Mode مانیتور (Response Time: Fast)"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <TextBox Grid.Row="3" x:Name="TxtLog" Margin="0,10,0,0" Background="#0F172A" Foreground="#A5F3FC"
                 FontFamily="Consolas" FontSize="11" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" FlowDirection="RightToLeft"/>
    </Grid>
</Window>
