<Window x:Class="AMINKeyboardClipboard.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="خوش آمدید"
        Width="520"
        Height="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI, Tahoma"
        FlowDirection="RightToLeft">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="به AMIN Keyboard &amp; Clipboard خوش آمدید"
                   FontSize="21"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"/>

        <Border Grid.Row="1"
                Background="{StaticResource PanelBrush2}"
                CornerRadius="12"
                Padding="18"
                Margin="0,18,0,0">
            <TextBlock TextWrapping="Wrap"
                       LineHeight="26"
                       Foreground="#D9D7E8"
                       Text="این برنامه یک کیبورد فارسی/انگلیسی شناور و یک مدیر تاریخچه متنی کلیپ‌بورد است.&#x0a;&#x0a;• فقط متن‌های کپی‌شده ذخیره می‌شوند؛ تصویر و فایل ذخیره نمی‌شوند.&#x0a;• همه داده‌ها فقط روی همین رایانه می‌مانند.&#x0a;• برنامه هیچ اتصال اینترنتی ندارد و چیزی ارسال نمی‌کند.&#x0a;• برنامه گذرواژه‌ها را شناسایی یا ذخیره نمی‌کند."/>
        </Border>

        <TextBlock Grid.Row="2"
                   Margin="0,16,0,0"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource MutedTextBrush}"
                   Text="برای شروع، ابتدا یک برنامه مقصد (مثل Notepad) را باز کنید و داخل محل تایپ کلیک کنید؛ سپس از تب «کیبورد مجازی» کیبورد شناور را نمایش دهید."/>

        <Button Grid.Row="3"
                Content="شروع"
                Width="130"
                HorizontalAlignment="Left"
                Margin="0,18,0,0"
                Background="{StaticResource AccentBrush}"
                Click="Start_Click"/>
    </Grid>
</Window>
