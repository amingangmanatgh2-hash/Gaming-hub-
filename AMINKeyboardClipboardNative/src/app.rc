#include <windows.h>

1 ICON "icon.ico"
1 24 "app.manifest"   /* 24 = RT_MANIFEST */

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,1,0,0
 PRODUCTVERSION 1,1,0,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "AMIN"
            VALUE "FileDescription",  "AMIN Keyboard & Clipboard"
            VALUE "FileVersion",      "1.1.0.0"
            VALUE "InternalName",     "AMINKeyboardClipboard"
            VALUE "LegalCopyright",   "Copyright (C) AMIN"
            VALUE "OriginalFilename", "AMINKeyboardClipboard.exe"
            VALUE "ProductName",      "AMIN Keyboard & Clipboard"
            VALUE "ProductVersion",   "1.1.0.0"
            VALUE "Comments",         "Native Win32 build. Requires no .NET Framework and no other runtime."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
